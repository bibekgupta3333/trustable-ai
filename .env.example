# Server-only variables. Required on Vercel; never use VITE_ prefixes.
TURSO_DATABASE_URL=turso://trustableai-bibekgupta3333.aws-us-east-1.turso.io
# Enter the real token directly in Vercel. Never commit it.
TURSO_AUTH_TOKEN=
# Generate separate secrets once; preserve the participant salt across deployments.
ADMIN_TOKEN=
PARTICIPANT_SALT=
STALE_MINUTES=120
# Local better-sqlite3 only: leave BOTH Turso variables unset to use this fallback.
# A missing token with a configured Turso URL is an error, not a local fallback.
DB_PATH=data/study.db
# npm run db:setup requires only TURSO_DATABASE_URL and TURSO_AUTH_TOKEN.
# npm run commands load .env then .env.local; existing shell variables take precedence.
